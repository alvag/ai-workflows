{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oraculo-cobertura.schema.json",
  "title": "La relación esperada del corpus — el oráculo de cobertura de la Fase 0.5",
  "description": "AC-2 de `dossier-oraculo` y AC-11 de `dossier-arnes`. Seis secciones: `relacion[]` y `exclusiones[]` forman una partición exhaustiva de las ternas del corpus; `desacuerdos[]` es el delta bidireccional entre el detector independiente y el predicado; `resoluciones[]` es el historial inmutable de los puntos ciegos; `procedencia` registra las tres etapas con su sello; `proxies[]` declara los seis límites.",
  "x-version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version_schema",
    "contrato_sha256",
    "corpus_identidad",
    "relacion",
    "exclusiones",
    "desacuerdos",
    "resoluciones",
    "procedencia",
    "proxies"
  ],
  "properties": {
    "version_schema": { "const": "1" },
    "contrato_sha256": { "$ref": "#/$defs/sha256" },
    "corpus_identidad": { "$ref": "#/$defs/identidad" },
    "relacion": {
      "type": "array",
      "items": { "$ref": "#/$defs/cobertura" },
      "description": "Lo que el consumidor lee. Lleva `ocurrencia` además de los cuatro campos que AC-2 nombra: sin ella la partición no es sobre las ternas del corpus, que es la unidad que AC-4 congela."
    },
    "exclusiones": {
      "type": "array",
      "items": { "$ref": "#/$defs/exclusion" }
    },
    "desacuerdos": {
      "type": "array",
      "items": { "$ref": "#/$defs/desacuerdo" }
    },
    "resoluciones": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolucion" }
    },
    "procedencia": { "$ref": "#/$defs/procedencia" },
    "proxies": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/proxy" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identidad": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "slug_de_flujo": { "type": "string", "pattern": "^(archived/)?[a-z0-9][a-z0-9._-]*$" },
    "task_id": { "type": "string", "pattern": "^T[0-9]+[A-Za-z]*$" },
    "ac_id": { "type": "string", "pattern": "^AC-[0-9]+[A-Za-z]*$" },
    "fuente_r2": {
      "type": "string",
      "enum": ["cubre", "campo_con_vineta", "campo_sin_vineta"],
      "description": "Las tres fuentes admitidas de R2, en su orden de precedencia. La fuente efectiva es la de mayor precedencia entre las presentes que coinciden."
    },
    "causa": {
      "type": "string",
      "enum": [
        "sin_cobertura",
        "cobertura_en_conflicto",
        "fila_duplicada",
        "fila_inexistente",
        "duplicado_normativo",
        "consume_no_tipado",
        "task_consumida_inexistente",
        "sin_produce",
        "bloque_global_inexistente",
        "bloque_global_duplicado",
        "bloque_global_ambiguo",
        "ac_inexistente",
        "enfoque_ausente",
        "rango_invertido",
        "extremo_inexistente",
        "rango_mixto"
      ],
      "description": "El enum cerrado de R5 / AC-5 de `dossier-arnes`. La igualdad contra el clasificador se comprueba allá, que es la única sede que lo tiene."
    },
    "cobertura": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flujo", "task_id", "ocurrencia", "fuente_r2", "ac"],
      "properties": {
        "flujo": { "$ref": "#/$defs/slug_de_flujo" },
        "task_id": { "$ref": "#/$defs/task_id" },
        "ocurrencia": { "type": "integer", "minimum": 1 },
        "fuente_r2": { "$ref": "#/$defs/fuente_r2" },
        "ac": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ac_id" }
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flujo", "task_id", "ocurrencia", "causas"],
      "properties": {
        "flujo": { "$ref": "#/$defs/slug_de_flujo" },
        "task_id": { "$ref": "#/$defs/task_id" },
        "ocurrencia": { "type": "integer", "minimum": 1 },
        "causas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/causa" },
          "description": "El conjunto COMPLETO, sin cortocircuito: una task puede tener tres causas a la vez."
        }
      }
    },
    "desacuerdo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "flujo",
        "task_id",
        "ocurrencia",
        "fuente_r2",
        "visto_detector",
        "visto_predicado",
        "clase_comparativa",
        "clase_adjudicada",
        "motivo",
        "evidencia"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^D[0-9]+$" },
        "flujo": { "$ref": "#/$defs/slug_de_flujo" },
        "task_id": { "$ref": "#/$defs/task_id" },
        "ocurrencia": { "type": "integer", "minimum": 1 },
        "fuente_r2": { "$ref": "#/$defs/fuente_r2" },
        "visto_detector": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ac_id" }
        },
        "visto_predicado": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ac_id" }
        },
        "clase_comparativa": {
          "type": "string",
          "enum": ["ve_mas", "ve_menos", "distintos"]
        },
        "clase_adjudicada": {
          "type": "string",
          "enum": ["punto_ciego", "exclusion_deliberada"]
        },
        "motivo": { "type": "string", "minLength": 1 },
        "evidencia": {
          "type": "string",
          "minLength": 1,
          "description": "Ruta, dentro de la evidencia sellada, de la salida cruda que sostiene este desacuerdo."
        }
      }
    },
    "resolucion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "flujo",
        "task_id",
        "ocurrencia",
        "contrato_al_detectar",
        "contrato_que_corrigio",
        "evidencia_original",
        "corrida_posterior",
        "resultado"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^R[0-9]+$" },
        "flujo": { "$ref": "#/$defs/slug_de_flujo" },
        "task_id": { "$ref": "#/$defs/task_id" },
        "ocurrencia": { "type": "integer", "minimum": 1 },
        "contrato_al_detectar": { "$ref": "#/$defs/sha256" },
        "contrato_que_corrigio": { "$ref": "#/$defs/sha256" },
        "evidencia_original": { "type": "string", "minLength": 1 },
        "corrida_posterior": { "$ref": "#/$defs/corrida_posterior" },
        "resultado": {
          "type": "string",
          "enum": ["desaparecio", "reclasificado_exclusion_deliberada"]
        }
      }
    },
    "corrida_posterior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completa", "flujos_procesados", "evidencia"],
      "properties": {
        "completa": {
          "const": true,
          "description": "Una reconciliación sobre una corrida parcial no acredita nada: el punto ciego pudo desaparecer porque su flujo no se procesó."
        },
        "flujos_procesados": { "type": "integer", "minimum": 1 },
        "evidencia": { "type": "string", "minLength": 1 }
      }
    },
    "procedencia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "etapas",
        "manifest_evidencia",
        "corpus_identidad",
        "familia_conductor",
        "familia_detector",
        "proyeccion_canonica"
      ],
      "properties": {
        "etapas": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/etapa" }
        },
        "manifest_evidencia": {
          "$ref": "#/$defs/identidad",
          "description": "El hash canónico del manifest de evidencia, no el de la salida cruda: sellar solo la salida dejaba que faltara o cambiara el prompt, la comparación o una reconciliación."
        },
        "corpus_identidad": { "$ref": "#/$defs/identidad" },
        "familia_conductor": { "$ref": "#/$defs/familia" },
        "familia_detector": { "$ref": "#/$defs/familia" },
        "proyeccion_canonica": {
          "type": "string",
          "minLength": 1,
          "description": "La definición de la identidad del corpus: algoritmo, orden, qué se incluye, codificación y serialización. Sin ella, dos implementaciones sellan objetos distintos afirmando las dos que sellaron el corpus."
        }
      }
    },
    "familia": { "type": "string", "enum": ["claude", "gpt-codex"] },
    "etapa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["etapa", "quien", "artefacto"],
      "properties": {
        "etapa": { "type": "string", "enum": ["detectar", "comparar", "adjudicar"] },
        "quien": { "type": "string", "minLength": 1 },
        "artefacto": { "type": "string", "minLength": 1 }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proxy", "acredita", "no_acredita"],
      "properties": {
        "proxy": {
          "type": "string",
          "enum": [
            "gate_estructural_de_git",
            "oraculo_congelado_como_autoridad",
            "adjudicacion_del_conductor",
            "alineacion_del_consumidor",
            "clausura_del_grafo_de_dependencias",
            "limpieza_de_la_plantilla_del_prompt"
          ]
        },
        "acredita": { "type": "string", "minLength": 1 },
        "no_acredita": { "type": "string", "minLength": 1 }
      }
    }
  }
}
